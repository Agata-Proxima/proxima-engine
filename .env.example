# LOCAL DEVELOPMENT ONLY. Change passwords and secrets before any shared deployment.
POSTGRES_USER=proxima
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=appdb

# PgBouncer authenticates the local Engine upstream connection using
# pgbouncer-userlist.txt. If POSTGRES_PASSWORD changes, update the matching
# "proxima" password in that file as well.
#
# Empty disables tenant-token enforcement for the first connectivity run.
# For tenant-isolation testing, set a strong secret and follow
# docs/TENANT_ISOLATION.md.
PROXIMA_TENANT_SIGNING_KEY=
PROXIMA_MAX_CONNECTIONS=128
